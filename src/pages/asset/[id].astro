---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabaseClient';

// Verifica se l'utente è loggato
const { data: { user } } = await supabase.auth.getUser();
if (!user) {
  return Astro.redirect('/login');
}

export async function getStaticPaths() {
  const { data } = await supabase.from('asset').select('id');
  return data?.map(asset => ({ params: { id: asset.id } })) || [];
}

const { id } = Astro.params;
const { data: asset, error } = await supabase
  .from('asset')
  .select('*')
  .eq('id', id)
  .single();

// Ottieni lo storico delle assegnazioni
let history = [];
if (asset) {
  const { data } = await supabase
    .from('assegnazioni')
    .select('*')
    .eq('asset_id', asset.id)
    .order('data_inizio', { ascending: false });
  history = data || [];
}

// Ottieni l'assegnazione corrente
let currentAssignment = null;
if (asset) {
  const { data } = await supabase
    .from('assegnazioni')
    .select('*')
    .eq('asset_id', asset.id)
    .is('data_fine', null)
    .single();
  currentAssignment = data;
}
---

<Layout title="Dettaglio Asset">
  {asset ? (
    <div class="p-4 max-w-4xl mx-auto">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-4">
        <h1 class="text-2xl font-bold text-[#8b5a2b] dark:text-[#c49a6c] break-all">
          {asset.numero_serie || asset.codice_univoco || 'Asset'}
        </h1>
        <div class="flex flex-wrap gap-2">
          <span class={`px-3 py-1 rounded text-sm whitespace-nowrap ${
            asset.stato === 'Assegnato' ? 'bg-green-200 dark:bg-green-900/50 text-green-800 dark:text-green-300' :
            asset.stato === 'In Magazzino' ? 'bg-yellow-200 dark:bg-yellow-900/50 text-yellow-800 dark:text-yellow-300' :
            asset.stato === 'In Manutenzione' ? 'bg-orange-200 dark:bg-orange-900/50 text-orange-800 dark:text-orange-300' :
            'bg-red-200 dark:bg-red-900/50 text-red-800 dark:text-red-300'
          }`}>
            {asset.stato}
          </span>
        </div>
      </div>

      <!-- Dettagli Asset -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {asset.codice_univoco && (
            <div><strong>Codice ENAIP:</strong> {asset.codice_univoco}</div>
          )}
          <div><strong>Numero Serie:</strong> {asset.numero_serie || 'N/A'}</div>
          <div><strong>Tipo:</strong> {asset.tipo_asset}</div>
          <div><strong>Marca:</strong> {asset.marca}</div>
          <div><strong>Modello:</strong> {asset.modello}</div>
          <div><strong>Sede:</strong> {asset.sede}</div>
          <div><strong>Stanza:</strong> {asset.stanza_ufficio || 'N/A'}</div>
          <div><strong>Data Acquisto:</strong> {asset.data_acquisto ? new Date(asset.data_acquisto).toLocaleDateString('it-IT') : 'N/A'}</div>
          <div><strong>Costo:</strong> {asset.costo_acquisto ? `€${asset.costo_acquisto}` : 'N/A'}</div>
          <div><strong>Scadenza Garanzia:</strong> {asset.scadenza_garanzia ? new Date(asset.scadenza_garanzia).toLocaleDateString('it-IT') : 'N/A'}</div>
          <div><strong>Assegnato a:</strong> {asset.assegnato_a || 'Nessuno'}</div>
        </div>
        {asset.note && (
          <div class="mt-4 border-t border-gray-200 dark:border-gray-700 pt-4">
            <strong>Note:</strong> {asset.note}
          </div>
        )}
        <div class="mt-4 text-sm text-gray-500 dark:text-gray-400 border-t border-gray-200 dark:border-gray-700 pt-4">
          <div>Inserito da: {asset.creato_da || 'Sistema'}</div>
          <div>Modificato da: {asset.modificato_da || 'Sistema'}</div>
          <div>Ultima modifica: {new Date(asset.updated_at).toLocaleString('it-IT')}</div>
        </div>
      </div>

      <!-- Assegnazione Corrente -->
      {currentAssignment && (
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-700 rounded-lg p-4 mb-6">
          <h3 class="font-semibold text-green-700 dark:text-green-400">🟢 Assegnato a:</h3>
          <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div><strong>Nome:</strong> {currentAssignment.dipendente_nome}</div>
            <div><strong>Email:</strong> {currentAssignment.dipendente_email}</div>
            <div><strong>Dal:</strong> {new Date(currentAssignment.data_inizio).toLocaleDateString('it-IT')}</div>
            <div><strong>Motivo:</strong> {currentAssignment.motivo || 'N/A'}</div>
          </div>
        </div>
      )}

      <!-- Storico Assegnazioni -->
      <h2 class="text-xl font-bold text-[#8b5a2b] dark:text-[#c49a6c] mb-3">📜 Storico Assegnazioni</h2>
      {history.length === 0 ? (
        <p class="text-gray-500 dark:text-gray-400">Nessuna assegnazione registrata.</p>
      ) : (
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden mb-6">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                  <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Dipendente</th>
                  <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Email</th>
                  <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Data Inizio</th>
                  <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Data Fine</th>
                  <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Motivo</th>
                </tr>
              </thead>
              <tbody>
                {history.map(record => (
                  <tr key={record.id} class="border-t border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <td class="p-3">{record.dipendente_nome}</td>
                    <td class="p-3">{record.dipendente_email}</td>
                    <td class="p-3">{new Date(record.data_inizio).toLocaleDateString('it-IT')}</td>
                    <td class="p-3">
                      {record.data_fine ? new Date(record.data_fine).toLocaleDateString('it-IT') : 
                        <span class="text-green-600 dark:text-green-400 font-medium">🟢 Attuale</span>}
                    </td>
                    <td class="p-3">{record.motivo || '-'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- Pulsanti Azione -->
      <div class="flex flex-wrap gap-2">
        <a href="/" class="bg-gray-200 dark:bg-gray-600 hover:bg-gray-300 dark:hover:bg-gray-500 text-gray-800 dark:text-white px-4 py-2 rounded transition-colors">
          ← Torna indietro
        </a>
        <a 
          href={`/assegna?id=${asset.id}`}
          class="bg-[#006a4e] hover:bg-[#005a3e] text-white px-4 py-2 rounded transition-colors"
        >
          🔄 Assegna
        </a>
        {asset.stato === 'Assegnato' && (
          <a 
            href={`/restituisci?id=${asset.id}`}
            class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded transition-colors"
          >
            📤 Restituisci
          </a>
        )}
        <a 
          href={`/stampa-etichette?id=${asset.id}`}
          class="bg-purple-500 hover:bg-purple-600 text-white px-4 py-2 rounded transition-colors"
        >
          🏷️ Stampa Etichetta
        </a>
        <a 
          href={`/asset/modifica/${asset.id}`}
          class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded transition-colors"
        >
          ✏️ Modifica
        </a>
      </div>
    </div>
  ) : (
    <div class="p-4">
      <h1 class="text-2xl font-bold text-red-600 dark:text-red-400">❌ Asset non trovato</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-2">L'asset che stai cercando non esiste o è stato eliminato.</p>
      <a href="/" class="mt-4 inline-block text-blue-500 hover:underline">← Torna alla dashboard</a>
    </div>
  )}
</Layout>
