---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabaseClient';
// 🔥 PROTEZIONE LOGIN 🔥
const { data: { user } } = await supabase.auth.getUser();
if (!user) {
  return Astro.redirect('/login');
}
const { data: assignments, error } = await supabase
  .from('assegnazioni')
  .select(`
    *,
    asset:asset_id (
      id,
      numero_serie,
      marca,
      modello,
      tipo_asset,
      codice_univoco
    )
  `)
  .order('data_inizio', { ascending: false })
  .limit(100);

const { count } = await supabase
  .from('assegnazioni')
  .select('*', { count: 'exact', head: true });

const totalAssignments = count || 0;
---

<Layout title="Storico Generale">
  <div class="p-4 max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-4">
      <h1 class="text-2xl font-bold text-[#8b5a2b] dark:text-[#c49a6c]">📜 Storico Generale</h1>
      <span class="bg-gray-200 dark:bg-gray-700 px-3 py-1 rounded text-sm text-gray-700 dark:text-gray-300">
        {totalAssignments} assegnazioni totali
      </span>
    </div>

    {error ? (
      <div class="bg-red-100 dark:bg-red-900/30 p-4 rounded text-red-700 dark:text-red-400">
        ❌ Errore nel caricamento dello storico: {error.message}
      </div>
    ) : assignments && assignments.length > 0 ? (
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-100 dark:bg-gray-700">
              <tr>
                <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Asset</th>
                <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Dipendente</th>
                <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Data Inizio</th>
                <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Data Fine</th>
                <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Motivo</th>
                <th class="p-3 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Stato</th>
              </tr>
            </thead>
            <tbody>
              {assignments.map(record => {
                const isActive = !record.data_fine;
                return (
                  <tr key={record.id} class="border-t border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    <td class="p-3">
                      <a 
                        href={`/asset/${record.asset.id}`}
                        class="text-[#006a4e] dark:text-[#4a9a7e] hover:underline"
                      >
                        {record.asset.numero_serie || record.asset.codice_univoco || record.asset.marca}
                      </a>
                      <span class="text-sm text-gray-500 dark:text-gray-400 block">
                        {record.asset.marca} {record.asset.modello}
                      </span>
                    </td>
                    <td class="p-3">
                      <div class="font-medium text-gray-900 dark:text-white">{record.dipendente_nome}</div>
                      <div class="text-sm text-gray-500 dark:text-gray-400">{record.dipendente_email}</div>
                    </td>
                    <td class="p-3 text-gray-700 dark:text-gray-300">{record.data_inizio}</td>
                    <td class="p-3">
                      {record.data_fine || <span class="text-green-600 dark:text-green-400 font-medium">Attuale</span>}
                    </td>
                    <td class="p-3 text-gray-700 dark:text-gray-300">{record.motivo || '-'}</td>
                    <td class="p-3">
                      <span class={`px-2 py-1 rounded text-sm ${
                        isActive ? 'bg-green-200 dark:bg-green-900/50 text-green-800 dark:text-green-300' : 'bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-400'
                      }`}>
                        {isActive ? '🟢 Attivo' : '📅 Chiuso'}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {totalAssignments > 100 && (
          <div class="p-3 bg-gray-50 dark:bg-gray-900 text-center text-sm text-gray-500 dark:text-gray-400">
            Mostrati 100 su {totalAssignments} assegnazioni.
          </div>
        )}
      </div>
    ) : (
      <div class="bg-yellow-50 dark:bg-yellow-900/30 p-8 rounded-lg text-center">
        <p class="text-gray-500 dark:text-gray-400">📭 Nessuna assegnazione registrata.</p>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">
          Inizia a censire gli asset e ad assegnarli ai dipendenti.
        </p>
      </div>
    )}

    <div class="mt-4">
      <a href="/" class="bg-gray-200 dark:bg-gray-600 hover:bg-gray-300 dark:hover:bg-gray-500 text-gray-700 dark:text-gray-200 px-4 py-2 rounded transition-colors inline-block">
        ← Torna alla dashboard
      </a>
    </div>
  </div>
</Layout>
