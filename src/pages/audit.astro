---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabaseClient';

// Ottieni gli ultimi 50 asset modificati
const { data: assets, error } = await supabase
  .from('asset')
  .select('*')
  .order('updated_at', { ascending: false })
  .limit(50);

// Ottieni il conteggio totale
const { count } = await supabase
  .from('asset')
  .select('*', { count: 'exact', head: true });
---

<Layout title="Audit Log">
  <div class="p-4 max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-4">
      <h1 class="text-2xl font-bold">📜 Audit Log</h1>
      <span class="bg-gray-200 dark:bg-gray-700 px-3 py-1 rounded text-sm">
        {count || 0} asset totali
      </span>
    </div>
    <p class="text-gray-600 dark:text-gray-400 mb-4">Traccia di tutte le modifiche agli asset</p>

    {error ? (
      <div class="bg-red-100 dark:bg-red-900/30 p-4 rounded text-red-700 dark:text-red-400">
        ❌ Errore nel caricamento: {error.message}
      </div>
    ) : assets && assets.length > 0 ? (
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-100 dark:bg-gray-700">
              <tr>
                <th class="p-3 text-left text-sm font-semibold">Asset</th>
                <th class="p-3 text-left text-sm font-semibold">Seriale</th>
                <th class="p-3 text-left text-sm font-semibold">Creato da</th>
                <th class="p-3 text-left text-sm font-semibold">Modificato da</th>
                <th class="p-3 text-left text-sm font-semibold">Ultima modifica</th>
              </tr>
            </thead>
            <tbody>
              {assets.map(asset => (
                <tr key={asset.id} class="border-t border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                  <td class="p-3">
                    <a href={`/asset/${asset.id}`} class="text-blue-500 hover:underline">
                      {asset.marca} {asset.modello}
                    </a>
                  </td>
                  <td class="p-3 font-mono text-sm">{asset.numero_serie || 'N/A'}</td>
                  <td class="p-3">{asset.creato_da || 'Sistema'}</td>
                  <td class="p-3">{asset.modificato_da || 'Sistema'}</td>
                  <td class="p-3 text-sm text-gray-500 dark:text-gray-400">
                    {new Date(asset.updated_at).toLocaleString('it-IT')}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {count && count > 50 && (
          <div class="p-3 bg-gray-50 dark:bg-gray-900 text-center text-sm text-gray-500 dark:text-gray-400">
            Mostrati 50 su {count} asset.
          </div>
        )}
      </div>
    ) : (
      <div class="bg-yellow-50 dark:bg-yellow-900/30 p-8 rounded-lg text-center">
        <p class="text-gray-500 dark:text-gray-400">📭 Nessun asset registrato.</p>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">
          Inizia a censire gli asset per vedere l'audit log.
        </p>
      </div>
    )}

    <div class="mt-4">
      <a href="/" class="text-blue-500 hover:underline">← Torna alla dashboard</a>
    </div>
  </div>
</Layout>
