---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabaseClient';

// Ottieni tutti gli asset
const { data: assets } = await supabase
  .from('asset')
  .select('*');

// Ottieni tutte le assegnazioni
const { data: assignments } = await supabase
  .from('assegnazioni')
  .select('*');

// Calcola statistiche
const totalAssets = assets?.length || 0;
const byType = {};
const bySede = {};
const byStato = {};
const assignmentsCount = assignments?.length || 0;

assets?.forEach(asset => {
  byType[asset.tipo_asset] = (byType[asset.tipo_asset] || 0) + 1;
  bySede[asset.sede] = (bySede[asset.sede] || 0) + 1;
  byStato[asset.stato] = (byStato[asset.stato] || 0) + 1;
});

// Ordina per valore decrescente
const sortedByType = Object.entries(byType).sort((a, b) => b[1] - a[1]);
const sortedBySede = Object.entries(bySede).sort((a, b) => b[1] - a[1]);
const sortedByStato = Object.entries(byStato).sort((a, b) => b[1] - a[1]);

// Calcola la percentuale per la barra
function getPercentage(value, total) {
  return total > 0 ? Math.round((value / total) * 100) : 0;
}
---

<Layout title="Statistiche Asset">
  <div class="p-4 max-w-6xl mx-auto">
    <h1 class="text-2xl font-bold mb-4">📊 Statistiche Asset</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-blue-100 p-4 rounded-lg text-center">
        <div class="text-3xl font-bold">{totalAssets}</div>
        <div class="text-sm">Totale Asset</div>
      </div>
      <div class="bg-green-100 p-4 rounded-lg text-center">
        <div class="text-3xl font-bold">{assignmentsCount}</div>
        <div class="text-sm">Assegnazioni totali</div>
      </div>
      <div class="bg-yellow-100 p-4 rounded-lg text-center">
        <div class="text-3xl font-bold">{Object.keys(bySede).length}</div>
        <div class="text-sm">Sedi coinvolte</div>
      </div>
      <div class="bg-purple-100 p-4 rounded-lg text-center">
        <div class="text-3xl font-bold">{Object.keys(byType).length}</div>
        <div class="text-sm">Tipologie di asset</div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Per Tipo -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold mb-4">📌 Per Tipo</h2>
        {sortedByType.length === 0 ? (
          <p class="text-gray-500">Nessun dato disponibile</p>
        ) : (
          <div class="space-y-2">
            {sortedByType.map(([type, count]) => (
              <div key={type}>
                <div class="flex justify-between text-sm">
                  <span>{type}</span>
                  <span>{count} ({getPercentage(count, totalAssets)}%)</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div 
                    class="bg-blue-500 h-2 rounded-full" 
                    style={{ width: `${getPercentage(count, totalAssets)}%` }}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Per Stato -->
      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold mb-4">📌 Per Stato</h2>
        {sortedByStato.length === 0 ? (
          <p class="text-gray-500">Nessun dato disponibile</p>
        ) : (
          <div class="space-y-2">
            {sortedByStato.map(([stato, count]) => {
              const color = {
                'Assegnato': 'bg-green-500',
                'In Magazzino': 'bg-yellow-500',
                'In Manutenzione': 'bg-orange-500',
                'Dismesso': 'bg-red-500'
              }[stato] || 'bg-gray-500';
              return (
                <div key={stato}>
                  <div class="flex justify-between text-sm">
                    <span>{stato}</span>
                    <span>{count} ({getPercentage(count, totalAssets)}%)</span>
                  </div>
                  <div class="w-full bg-gray-200 rounded-full h-2">
                    <div 
                      class={`${color} h-2 rounded-full`} 
                      style={{ width: `${getPercentage(count, totalAssets)}%` }}
                    ></div>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      <!-- Per Sede -->
      <div class="bg-white shadow rounded-lg p-6 md:col-span-2">
        <h2 class="text-lg font-semibold mb-4">📍 Per Sede</h2>
        {sortedBySede.length === 0 ? (
          <p class="text-gray-500">Nessun dato disponibile</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {sortedBySede.map(([sede, count]) => (
              <div key={sede}>
                <div class="flex justify-between text-sm">
                  <span>{sede}</span>
                  <span>{count} ({getPercentage(count, totalAssets)}%)</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div 
                    class="bg-purple-500 h-2 rounded-full" 
                    style={{ width: `${getPercentage(count, totalAssets)}%` }}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="mt-6">
      <a href="/" class="text-blue-500 hover:underline">← Torna alla dashboard</a>
    </div>
  </div>
</Layout>
