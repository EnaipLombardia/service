---
export interface Props {
  title: string;
}

const { title } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<!DOCTYPE html>
<html lang="it" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>{title}</title>
    
    <!-- PWA Meta Tags -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#3b82f6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" />
    
    <style>
      /* Transizioni per il tema */
      * {
        transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      }
      
      /* === DARK MODE - CORREZIONI CONTRASTO === */
      .dark {
        background-color: #0f172a;
        color: #f1f5f9;
      }
      
      /* Sfondo contenitori */
      .dark .bg-white { background-color: #1e293b; }
      .dark .bg-gray-50 { background-color: #1e293b; }
      .dark .bg-gray-100 { background-color: #334155; }
      .dark .bg-gray-200 { background-color: #334155; }
      .dark .bg-gray-300 { background-color: #475569; }
      
      /* Bordi */
      .dark .border-gray-200 { border-color: #334155; }
      .dark .border-gray-300 { border-color: #475569; }
      .dark .border-gray-100 { border-color: #1e293b; }
      .dark .divide-y > * + * { border-color: #334155; }
      .dark .border-b { border-color: #334155; }
      .dark .border-t { border-color: #334155; }
      
      /* Testi - CORRETTI PER LEGGIBILITÀ */
      .dark .text-gray-900 { color: #f1f5f9; }
      .dark .text-gray-800 { color: #e2e8f0; }
      .dark .text-gray-700 { color: #cbd5e1; }
      .dark .text-gray-600 { color: #94a3b8; }
      .dark .text-gray-500 { color: #94a3b8; }
      .dark .text-gray-400 { color: #64748b; }
      .dark .text-white { color: #ffffff; }
      .dark .text-black { color: #e2e8f0; }
      
      /* Input, Select, Textarea in Dark Mode */
      .dark input,
      .dark select,
      .dark textarea {
        background-color: #1e293b;
        color: #f1f5f9;
        border-color: #475569;
      }
      .dark input:focus,
      .dark select:focus,
      .dark textarea:focus {
        border-color: #3b82f6;
        outline: none;
        ring: 2px solid #3b82f6;
      }
      .dark input::placeholder,
      .dark textarea::placeholder {
        color: #94a3b8;
      }
      .dark label {
        color: #e2e8f0;
      }
      
      /* Ombre in Dark Mode */
      .dark .shadow { box-shadow: 0 1px 3px 0 rgba(0,0,0,0.5); }
      .dark .shadow-lg { box-shadow: 0 10px 15px -3px rgba(0,0,0,0.5); }
      .dark .shadow-md { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.5); }
      
      /* Colori delle card statistiche in Dark Mode */
      .dark .bg-blue-100 { background-color: #1e3a5f; color: #93c5fd; }
      .dark .bg-green-100 { background-color: #14532d; color: #86efac; }
      .dark .bg-yellow-100 { background-color: #78350f; color: #fcd34d; }
      .dark .bg-orange-100 { background-color: #7c2d12; color: #fdba74; }
      .dark .bg-red-100 { background-color: #7f1d1d; color: #fca5a5; }
      .dark .bg-purple-100 { background-color: #4c1d95; color: #c4b5fd; }
      .dark .bg-indigo-100 { background-color: #3730a3; color: #a5b4fc; }
      .dark .bg-teal-100 { background-color: #134e4a; color: #5eead4; }
      .dark .bg-pink-100 { background-color: #831843; color: #f9a8d4; }
      
      /* Hover in Dark Mode */
      .dark .hover\:bg-gray-50:hover { background-color: #334155; }
      .dark .hover\:bg-gray-100:hover { background-color: #334155; }
      .dark .hover\:bg-gray-200:hover { background-color: #475569; }
      
      /* Animazioni */
      @keyframes bounceIn {
        0% { transform: translateY(100px) scale(0.9); opacity: 0; }
        60% { transform: translateY(-10px) scale(1.02); opacity: 1; }
        100% { transform: translateY(0) scale(1); opacity: 1; }
      }
      .animate-bounce-in {
        animation: bounceIn 0.5s ease-out;
      }
      
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
      }
      .animate-pulse-slow {
        animation: pulse 1.5s ease-in-out infinite;
      }

      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in-up {
        animation: fadeInUp 0.4s ease-out;
      }
      
      /* Scrollbar personalizzata */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
      }
      .dark ::-webkit-scrollbar-track {
        background: #1e293b;
      }
      ::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #64748b;
      }
      
      /* Stampa etichette */
      @media print {
        .no-print { display: none !important; }
        .print-only { display: block !important; }
        body { background: white !important; }
        .dark { background: white !important; color: black !important; }
      }
      
      /* Mobile friendly */
      @media (max-width: 640px) {
        .container { padding-left: 0.5rem; padding-right: 0.5rem; }
      }
    </style>
    
    <script>
      // Rileva il tema salvato o le preferenze del sistema
      if (localStorage.getItem('theme') === 'dark' || 
          (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
      
      // Registra il Service Worker per PWA
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(registration => {
              console.log('✅ Service Worker registrato con successo');
            })
            .catch(err => {
              console.log('❌ Service Worker registrazione fallita: ', err);
            });
        });
      }
    </script>
  </head>
  
  <body>
    <main>
      <!-- Header con Logo, Dashboard Button e Dark Mode Toggle -->
      <div class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 shadow-sm sticky top-0 z-40 no-print">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-2">
          <!-- Logo e pulsante Dashboard (nascosto in homepage) -->
          <div class="flex items-center gap-3">
            {!isHome && (
              <a 
                href="/" 
                class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium text-sm bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1"
                title="Torna alla Dashboard"
              >
                <span>←</span> Dashboard
              </a>
            )}
            <img 
              src="/images/enaip-logo.png" 
              alt="ENAIP Lombardia" 
              class="h-8 w-auto"
              onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-lg font-bold text-blue-700 dark:text-blue-400\'>ENAIP</span>';"
            />
          </div>
          
          <!-- Pulsante Tema -->
          <button 
            id="themeToggle"
            class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
            aria-label="Cambia tema (Dark/Light)"
            title="Cambia tema"
          >
            <span id="themeIcon">🌙</span>
          </button>
        </div>
      </div>
      
      <!-- Contenuto della pagina -->
      <slot />
    </main>

    <script>
      const toggle = document.getElementById('themeToggle');
      const icon = document.getElementById('themeIcon');
      
      toggle.addEventListener('click', () => {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
          html.classList.remove('dark');
          localStorage.setItem('theme', 'light');
          icon.textContent = '🌙';
        } else {
          html.classList.add('dark');
          localStorage.setItem('theme', 'dark');
          icon.textContent = '☀️';
        }
      });
    </script>
  </body>
</html>
